# Salin jadi .env lalu isi nilainya. JANGAN commit file .env yang sudah diisi.

# ============ Bot Telegram ============
# Wajib. Dapatkan dari @BotFather.
TG_BOT_TOKEN=

# Bahasa judul/metadata. "id" = Indonesia, "en" = Inggris.
BOT_LANG=id

# ============ Gateway ============
GW_PORT=8100
# Alamat gateway dari sudut pandang bot (biasanya lokal).
GW_BASE=http://127.0.0.1:8100
# Alamat gateway yang bisa dijangkau browser pengguna (untuk link download).
# Kosongkan bila gateway dan player di host yang sama.
GW_PUBLIC_BASE=

# ============ Web player ============
PLAYER_PORT=8200
# URL publik player. Kalau kosong, dideteksi otomatis dari IP keluar server.
PLAYER_PUBLIC_URL=
# Direktori cache MP4 hasil remux untuk fallback universal.
PLAYER_CACHE_DIR=/opt/missav/cache/player

# ============ FlareSolverr (opsional, sangat disarankan) ============
# missav.ws dilindungi Cloudflare. FlareSolverr membantu melewatinya.
GW_FLARESOLVERR=http://127.0.0.1:8191
# Batasi permintaan paralel ke FlareSolverr agar tidak kehabisan memori.
GW_FS_CONCURRENCY=3

# ============ Proxy pool (opsional) ============
# Satu proxy per baris, format ip:port atau user:pass@ip:port
# Kosongkan bila tidak memakai proxy.
GW_PROXY_FILE=

# ============ Cache & rate limit ============
GW_CACHE_DIR=/opt/missav/cache
GW_PAGE_TTL=900
GW_STREAM_TTL=1800
GW_INDEX_TTL=21600
# Permintaan per menit per IP.
GW_RATELIMIT=240
GW_WORKERS=2

# ============ API key (opsional) ============
# Kosong = semua endpoint publik. Isi bila ingin memproteksi API.
GW_API_KEY=
